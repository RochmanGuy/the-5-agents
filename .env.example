# ============================================
# The 5 Agents - Environment Variables
# ============================================
# העתק קובץ זה ל-.env ומלא את הערכים האמיתיים
# Copy this file to .env and fill in real values

# --- Anthropic (Claude) ---
# נדרש עבור כל הסוכנים בצוות
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- OpenAI (אופציונלי - ליצירת תמונות עבור יובל) ---
OPENAI_API_KEY=your-openai-api-key-here

# --- Tavily / Search API (אופציונלי - למחקר של חן) ---
TAVILY_API_KEY=your-tavily-api-key-here

# --- הגדרות כלליות ---
# מודל ברירת מחדל לסוכנים
DEFAULT_MODEL=claude-opus-4-7

# רמת לוגים: debug | info | warn | error
LOG_LEVEL=info
